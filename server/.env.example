# Copy to .env and fill in. .env is gitignored; never commit real values.

# Neon Postgres connection string. Read only by the server, never sent to the browser.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Separate database used by `npm test` and `npm run migrate:test`. Tests truncate the notes table.
TEST_DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/creative_episode_test

# Listen address. 127.0.0.1 keeps it on this machine; set it to the office LAN/VPN interface
# (or 0.0.0.0 on a host reachable only from the private network) to share the wall.
HOST=127.0.0.1
PORT=3000

# Which company's wall this server shows. Must exist in the companies table.
HUB_COMPANY_SLUG=kmk

# Proxy hops in front of the server. Leave empty when running directly; set to 1 on Render
# (its HTTPS proxy), or every save fails the same-origin check.
TRUST_PROXY=
